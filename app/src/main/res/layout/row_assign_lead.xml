<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/clMainView"
        android:padding="@dimen/_10sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ivUser"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/circle_bg"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/roboto_medium"
            android:text="Ashok Tata"
            android:textColor="@color/dark_gray_text"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivUser"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTotalAllotment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/roboto_regular"
            android:text="Total Allotment: "
            android:textColor="@color/dark_gray_text"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toEndOf="@id/ivUser"
            app:layout_constraintTop_toBottomOf="@id/tvUserName" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTotalAllotmentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:fontFamily="@font/roboto_medium"
            android:text="22"
            android:textColor="@color/blue_text"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toEndOf="@id/tvTotalAllotment"
            app:layout_constraintTop_toTopOf="@id/tvTotalAllotment" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/tvTotalAllotment"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_weight="1"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:background="@drawable/communicated_rect_bg"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingStart="@dimen/_10ssp"
                android:id="@+id/clComm"
                app:layout_constraintEnd_toStartOf="@id/clConv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/communicated"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textColor="@color/color_communicated"
                    android:textSize="@dimen/_8ssp"
                    android:ellipsize="end"
                    android:id="@+id/tvTitleComm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCommunicated"
                    app:layout_constraintStart_toStartOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCommunicated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text=" 10"
                    app:layout_constraintStart_toEndOf="@id/tvTitleComm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/color_communicated"
                    android:textSize="@dimen/_9ssp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_weight="1"
                android:background="@drawable/converted_rect_bg"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:id="@+id/clConv"
                app:layout_constraintEnd_toStartOf="@id/clPend"
                android:paddingStart="@dimen/_10ssp"
                app:layout_constraintStart_toEndOf="@id/clComm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/converted"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textColor="@color/color_converted"
                    android:textSize="@dimen/_8ssp"
                    android:ellipsize="end"
                    android:id="@+id/tvConvTitle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvConverted"
                    app:layout_constraintStart_toStartOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvConverted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text=" 10"
                    app:layout_constraintStart_toEndOf="@id/tvConvTitle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/color_converted"
                    android:textSize="@dimen/_9ssp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <!--//pending-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_weight="1"
                android:background="@drawable/pending_rect_bg"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                android:id="@+id/clPend"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingStart="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/clConv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/pending"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/color_pending"
                    android:textSize="@dimen/_9ssp"
                    android:ellipsize="end"
                    android:id="@+id/tvPendingCountTitle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvPending"
                    app:layout_constraintStart_toStartOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text=" 10"
                    app:layout_constraintStart_toEndOf="@id/tvPendingCountTitle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/color_pending"
                    android:textSize="@dimen/_9ssp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

